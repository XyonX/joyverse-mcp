# LLM credentials -- copy this file to .env and fill in.
# mcp_client/.env is gitignored. Never commit a real key.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Leave blank for api.openai.com. Set for any OpenAI-compatible provider
# (OpenRouter, Groq, Together, a local llama.cpp/vLLM server, etc).
OPENAI_BASE_URL=

# --- R2 / server ---
# These are read from the repo-root .env by the client, listed here for
# reference only. Do not duplicate secrets into this file.
# JWT_SECRET=...
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_R2_ACCESS_KEY_ID=...
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
# CLOUDFLARE_R2_BUCKET_NAME=joyverse-user-data
