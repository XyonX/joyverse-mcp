# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=joyverse-user-data

# --- Bearer tokens (self-issued, legacy path) ---
# Signs the tokens minted by scripts/generate_token.py. Optional when
# OAUTH_ENABLED=true and you only use OAuth -- the two paths are independent.
JWT_SECRET=your-super-secret-key

# --- OAuth (Auth0) ---
# The MCP resource server validates tokens issued by this tenant.
# Leave OAUTH_ENABLED=false until the values below are real, otherwise the
# server boots with bearer-only auth.
OAUTH_ENABLED=false

# Tenant domain: Auth0 dashboard -> Settings -> General -> Domain.
# No https:// prefix. The issuer is derived as https://<domain>/ (with slash).
AUTH0_DOMAIN=your-tenant.us.auth0.com

# API audience: Applications -> APIs -> your API -> Settings -> Identifier.
# A token minted for a different audience must be rejected, so this must match
# the API you actually configured.
AUTH0_AUDIENCE=https://api.your-domain.com

# Client ID: Applications -> your app -> Settings -> General -> Client ID.
# Blank is fine unless you use Dynamic Client Registration (Claude Desktop,
# ChatGPT connectors), which register themselves via /oidc/register.
AUTH0_CLIENT_ID=

# Client SECRET: Applications -> your app -> Settings -> Client Secrets.
#
# NOT a production dependency. The MCP server only verifies tokens, it never
# issues them, so it never needs this. It is required solely by the test
# scripts in scripts/, which mint a token to exercise the OAuth path.
AUTH0_CLIENT_SECRET=

# Where this server is publicly reachable. Used to build the RFC 9728
# discovery URLs advertised to clients, so it must match the origin a client
# actually visits -- no trailing slash on the path.
PUBLIC_BASE_URL=http://localhost:8001

# --- Test-only credentials ---
# A throwaway account used by scripts/live_oauth_check.py to mint a real
# user-delegated token. Create it under Authentication -> Database ->
# Username-Password-Authentication, or via scripts/setup_test_user.py.
# Use a throwaway password, never a real one.
AUTH0_TEST_EMAIL=oauth-test@example.com
AUTH0_TEST_PASSWORD=change-me